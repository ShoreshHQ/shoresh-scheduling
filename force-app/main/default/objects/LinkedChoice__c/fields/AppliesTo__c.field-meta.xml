        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>All</fullName>
                <default>true</default>
                <label>All</label>
            </value>
            <value>
                <fullName>OnlyThese</fullName>
                <default>false</default>
                <label>Only these</label>
            </value>
            <value>
                <fullName>AllExcept</fullName>
                <default>false</default>
                <label>All except</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
