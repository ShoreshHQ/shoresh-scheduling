<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ExactlyOneOwner</fullName>
    <active>true</active>
    <description
  >Exactly one owner: a recurring activity or a linked choice.</description>
    <errorConditionFormula
  >IF(ISBLANK(RecurringActivity__c), 0, 1) + IF(ISBLANK(LinkedChoice__c), 0, 1) &lt;&gt; 1</errorConditionFormula>
    <errorMessage>Choose what this row is for.</errorMessage>
</ValidationRule>
