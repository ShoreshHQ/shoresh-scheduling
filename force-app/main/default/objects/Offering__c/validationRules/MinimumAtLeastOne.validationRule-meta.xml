<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MinimumAtLeastOne</fullName>
    <active>true</active>
    <description>A minimum, when there is one, is 1 or more.</description>
    <errorConditionFormula
  >AND(NOT(ISBLANK(MinimumToRun__c)), MinimumToRun__c &lt; 1)</errorConditionFormula>
    <errorDisplayField>MinimumToRun__c</errorDisplayField>
    <errorMessage>Must be 1 or more, or blank for no minimum.</errorMessage>
</ValidationRule>
