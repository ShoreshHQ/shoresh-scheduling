<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DateRequired</fullName>
    <active>true</active>
    <description
  >A date is required. A validation rule rather than a required field, so the permission set can grant it.</description>
    <errorConditionFormula>ISBLANK(Date__c)</errorConditionFormula>
    <errorDisplayField>Date__c</errorDisplayField>
    <errorMessage>Choose a date.</errorMessage>
</ValidationRule>
