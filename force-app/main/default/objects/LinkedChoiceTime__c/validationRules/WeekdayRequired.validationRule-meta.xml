<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>WeekdayRequired</fullName>
    <active>true</active>
    <description
  >A weekday is required. A validation rule rather than a required field, as for other choices.</description>
    <errorConditionFormula>ISBLANK(TEXT(Weekday__c))</errorConditionFormula>
    <errorDisplayField>Weekday__c</errorDisplayField>
    <errorMessage>Choose a day.</errorMessage>
</ValidationRule>
