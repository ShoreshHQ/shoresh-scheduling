<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>EndOnOrAfterStart</fullName>
    <active>true</active>
    <description>Dates in order.</description>
    <errorConditionFormula>EndDate__c &lt; StartDate__c</errorConditionFormula>
    <errorDisplayField>EndDate__c</errorDisplayField>
    <errorMessage
  >The end date must be on or after the start date.</errorMessage>
</ValidationRule>
